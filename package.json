    "hono": "^4.11.4",
    "jotai": "^2.16.2",
    "jotai-family": "^1.0.1",
    "kiso.css": "^1.2.3",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
